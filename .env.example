# Appwrite Console > Settings sayfasından alınır. Sonu /v1 ile bitmeli.
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://BOLGE.cloud.appwrite.io/v1
# Appwrite Console > Settings > Project ID
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
# Appwrite Console > Databases > Wallet > Database ID
EXPO_PUBLIC_APPWRITE_DATABASE_ID=
# Appwrite'a platform olarak eklediğin uygulama kimliği (ör. com.alperen.cuzdan)
EXPO_PUBLIC_APPWRITE_PLATFORM=
# DİKKAT: API key gibi gizli değerleri ASLA EXPO_PUBLIC_ önekiyle buraya yazma.